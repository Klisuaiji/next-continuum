float SampleDepthMax10x10(ivec2 iPos) {
    float maxDepth = -1.0;

    for (int y = -5; y <= 5; ++y) {
        for (int x = -5; x <= 5; ++x) {
            ivec2 center = iPos + ivec2(x, y);

            float depth = texelFetch(depthTexBack, center, 0).x;

            maxDepth = max(maxDepth, depth);
        }
    }

    return maxDepth;
}

vec2 CalculateCloudMotionVectors(vec2 nCoord, vec3 worldPos) {
    vec2 windDir2D = normalize(VOLUMETRIC_CLOUDS_WIND_DIR.xz);

	vec3 projection = worldPos;
         projection.xz -= windDir2D * TIME_SPEED * VOLUMETRIC_CLOUDS_SPEED * frameTime * (VOLUMETRIC_CLOUDS_SCALE * (cloudAltitude + cloudHeight));
    
    projection = (cameraPosition - previousCameraPosition) + projection;
    projection = mat3(CameraTransformsPrevious.viewMatrix) * projection + CameraTransformsPrevious.viewMatrix[3].xyz;
    projection = (diagonal3(CameraTransformsPrevious.projectionMatrix) * projection + CameraTransformsPrevious.projectionMatrix[3].xyz) / -projection.z * 0.5 + 0.5;

	return (nCoord - projection.xy);
}

void main() {
    InitRand(uint(gl_GlobalInvocationID.x + viewWidth * gl_GlobalInvocationID.y) + (uint(viewWidth) * uint(viewHeight) * floatBitsToUint(frameTimeCounter)));

    ivec2 iPos = ivec2(gl_GlobalInvocationID.xy);
    vec2 nCoord = (iPos + 0.5) / floor(viewDimensions * workGroupsRender);
         nCoord += (CHECKER_OFFSETS_4x4[frameCounter % 16] / 4.0) / (viewDimensions * workGroupsRender);

    float depth = SampleDepthMax10x10(ivec2(nCoord * viewDimensions)).x;
    float dither = BlueNoiseTemporal(blueNoiseTex, iPos, frameCounter);

    mat2x3 position;
    position[0] = CalculateViewSpacePositionUnjittered(vec3(nCoord, depth));
    position[1] = CalculateWorldSpacePosition(position[0]);

    float normFactor = inversesqrt(dot(position[0], position[0]));
	vec3 viewVector = normFactor * -position[0];
    vec3 worldVector = normalize(position[1] - CameraTransforms.viewMatrixInverse[3].xyz);

    float VoL = dot(-viewVector, SceneData.lightVector);

    VolumetricData vd = CalculateVolumetricVariables(viewVector, VoL);

    vec4 clouds = CalculateVolumetricClouds(worldVector, depth, dither, length(position[1]), VOLUMETRIC_CLOUDS_QUALITY, VOLUMETRIC_CLOUDS_DIRECT_QUALITY, true, false);
    vec2 motionVector = CalculateCloudMotionVectors(nCoord, worldVector * clouds.a);

    imageStore(cloudImg, iPos, clouds);
    imageStore(colorimg13, iPos, vec4(motionVector, 0.0, 0.0));
}