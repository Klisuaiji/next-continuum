layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout (r11f_g11f_b10f) uniform image2D skyScatteringImg;
layout (r11f_g11f_b10f) uniform image2D skyTransmittanceImg;

const ivec3 workGroups = ivec3(8, 4, 1);

#include "../InternalLib/Syntax.glsl"

uniform sampler3D cloudNoiseTex;
uniform sampler3D curlNoiseTex;

uniform sampler3D lightPropagationVolume_r;

uniform sampler2D vxDepthTexOpaque;
uniform sampler2D depthTexFront, depthTexBack;

uniform sampler2D colortex2;
uniform sampler2D colortex3;
uniform sampler2D colortex9;

uniform sampler2D shadowtex0, shadowtex1;
uniform sampler2D shadowcolor, shadowcolor1;

uniform sampler2D noisetex;
uniform sampler2D blueNoiseTex;

uniform mat4 shadowModelView, shadowModelViewInverse;
uniform mat4 shadowProjection, shadowProjectionInverse;

uniform vec3 cameraPosition;
uniform vec3 sunPosition;
uniform vec3 upPosition;

uniform ivec2 eyeBrightnessSmooth;

uniform float eyeAltitude;
uniform float wetness;
uniform float frameTimeCounter;

uniform int frameCounter;
uniform float viewWidth, viewHeight;
uniform int heldItemId;
uniform int worldTime;

#define composite0 // stupid library requires this.

#include "../InternalLib/Utilities.glsl"
#include "../InternalLib/Debug.glsl"
#include "../InternalLib/Uniform/Matrices.glsl"
#include "../InternalLib/Common/SpaceConversions.glsl"
#include "../InternalLib/Common/Rand.glsl"
#include "../InternalLib/Fragment/Sky.fsh"
#include "../InternalLib/Fragment/Clouds.fsh"

void main() {
    InitRand(uint(gl_GlobalInvocationID.x + viewWidth * gl_GlobalInvocationID.y) + (uint(viewWidth) * uint(viewHeight) * floatBitsToUint(frameTimeCounter)));

    ivec2 iPos = ivec2(gl_GlobalInvocationID);
    vec2 nCoord = vec2(iPos) / vec2(workGroups * gl_WorkGroupSize);

    vec3 viewPos = CalculateViewSpacePosition(vec3(nCoord,  1.0));
    vec3 worldPos = CalculateWorldSpacePosition(viewPos);

    vec3 viewVector = normalize(viewPos);
    vec3 worldVector = normalize(worldPos - CameraTransforms.viewMatrixInverse[3].xyz);

    vec3 scattering = vec3(0.0);
    vec3 transmittance = vec3(1.0);

    scattering = sky_atmosphere(vec3(0.0), viewVector, upPosition * 0.01, sunPosition * 0.01, -sunPosition * 0.01, sky_sunColor, sky_moonColor, 25, transmittance);
    
    imageStore(skyScatteringImg, iPos, vec4(scattering, 0.0));
    imageStore(skyTransmittanceImg, iPos, vec4(transmittance, 0.0));
}