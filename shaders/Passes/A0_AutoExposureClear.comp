/* M1 - GPU histogram auto-exposure (stage 0: reset the per-frame accumulator).
 * Port reference: 2.1.3 passes/camera/genHistogram.comp + autoExposureHistogram SSBO.
 * Self-gated: compiles to a no-op unless AUTO_EXPOSURE is enabled.
 * Self-written for the Redux base; keeps Redux file semantics untouched. */
layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

#include "../InternalLib/Syntax.glsl"

void main() {
    #ifdef AUTO_EXPOSURE
        if (gl_GlobalInvocationID == uvec3(0)) {
            for (int i = 0; i < 128; ++i) AutoExposureHistogram.accumulator[i] = 0;
            memoryBarrierBuffer();
        }
    #endif
}
