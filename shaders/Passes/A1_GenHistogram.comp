/* M1 - GPU histogram auto-exposure (stage 1: build the luminance histogram).
 * Port reference: 2.1.3 passes/camera/genHistogram.comp.
 * Center-weighted tent histogram over the HDR scene (colortex2), accumulated
 * through shared memory + atomicAdd into the binding=4 SSBO.
 * Self-gated: compiles to a no-op unless AUTO_EXPOSURE is enabled. */
layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

uniform sampler2D colortex2;
uniform vec2 pixelSize;

#include "../InternalLib/Syntax.glsl"
#include "../InternalLib/Utilities.glsl"

void main() {
    #ifdef AUTO_EXPOSURE
        const int BINS = 128;
        const float MIN_LUM = 0.01;
        const float MAX_LUM = 100000.0;
        const float EV_MIN = log2(MIN_LUM);
        const float EV_SPAN = log2(MAX_LUM) - log2(MIN_LUM);

        shared int localHist[128];

        uint idx = gl_LocalInvocationIndex;
        if (idx < 128u) localHist[idx] = 0;
        memoryBarrier();
        barrier();

        vec2 uv = (gl_GlobalInvocationID.xy + 0.5) * pixelSize;
        if (uv.x <= 1.0 && uv.y <= 1.0) {
            vec3 linear = DecodeColor(DecodeRGBE8(texture2D(colortex2, uv)));
            float lum = clamp(RGBToLuma(linear), MIN_LUM, MAX_LUM);
            float bin = (log2(lum) - EV_MIN) / EV_SPAN * float(BINS);

            float fbin = floor(bin);
            int b0 = int(clamp(fbin, 0.0, float(BINS - 1)));
            int b1 = int(clamp(fbin + 1.0, 0.0, float(BINS - 1)));
            float w1 = bin - fbin;
            float w0 = 1.0 - w1;

            // center weighting (2.1.3 favours the region around the focal point)
            vec2 cc = uv * 2.0 - 1.0;
            float cw = exp(-dot(cc, cc) * 0.8);

            atomicAdd(localHist[b0], int(500.0 * w0 * cw));
            atomicAdd(localHist[b1], int(500.0 * w1 * cw));
        }
        memoryBarrier();
        barrier();

        if (idx < 128u) atomicAdd(AutoExposureHistogram.accumulator[idx], localHist[idx]);
    #endif
}
