/* M1 - GPU histogram auto-exposure (stage 2: reduce + temporal adapt).
 * Port reference: 2.1.3 passes/camera/exposeImage.comp.
 * Self-contained (no Iris-injected helpers): reduces the histogram to a
 * center-weighted mean luminance, temporally blends it with the previous
 * adapted value and stores the exposure multiplier that C7 uses instead of
 * the per-pixel luminance. Manual camera mode bypasses M1 in C7.
 * Self-gated: compiles to a no-op unless AUTO_EXPOSURE is enabled. */
layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

#include "../InternalLib/Syntax.glsl"

// Dolby-style exposure clamps, matching the Redux Camera.fsh ranges.
#if defined DIM_OVERWORLD
    #define AUTO_EXPOSURE_MIN_LUM 25.0
    #define AUTO_EXPOSURE_MAX_LUM 1500.0
#elif defined DIM_NETHER
    #define AUTO_EXPOSURE_MIN_LUM 25.0
    #define AUTO_EXPOSURE_MAX_LUM 60.0
#elif defined DIM_END
    #define AUTO_EXPOSURE_MIN_LUM 60.0
    #define AUTO_EXPOSURE_MAX_LUM 120.0
#else
    #define AUTO_EXPOSURE_MIN_LUM 25.0
    #define AUTO_EXPOSURE_MAX_LUM 1500.0
#endif

// Iris injects the camera exposure-compensation option globally; glslang does
// not, so default it to no compensation for a clean standalone compile.
#ifndef CAMERA_EV
    #define CAMERA_EV 0.0
#endif

float AutoEV100(float avgLuminance) {
    return log2(avgLuminance * 8.0);
}

float AutoExposureFromEV100(float EV100) {
    return 0.833333 * exp2(-EV100);
}

void main() {
    #ifdef AUTO_EXPOSURE
        const int BINS = 128;
        const float MIN_LUM = 0.01;
        const float MAX_LUM = 100000.0;
        const float EV_MIN = log2(MIN_LUM);
        const float EV_SPAN = log2(MAX_LUM) - log2(MIN_LUM);

        if (gl_GlobalInvocationID == uvec3(0)) {
            int total = 0;
            for (int i = 0; i < BINS; ++i) total += AutoExposureHistogram.accumulator[i];

            float mean = AutoExposureHistogram.adaptedLuminance;
            if (total > 0) {
                float sum = 0.0;
                for (int i = 0; i < BINS; ++i) {
                    float lum = exp2(EV_MIN + (float(i) + 0.5) / float(BINS) * EV_SPAN);
                    sum += lum * float(AutoExposureHistogram.accumulator[i]);
                }
                mean = sum / float(total);
            }

            // Dolby-style clamp, matching the Redux auto-exposure range.
            mean = clamp(mean, AUTO_EXPOSURE_MIN_LUM, AUTO_EXPOSURE_MAX_LUM);
            float adapted = mix(AutoExposureHistogram.adaptedLuminance, mean, 0.08);

            AutoExposureHistogram.adaptedLuminance = adapted;
            AutoExposureHistogram.exposureMultiplier =
                AutoExposureFromEV100(AutoEV100(adapted) - CAMERA_EV) * 3.14159265;
            memoryBarrierBuffer();
        }
    #endif
}
