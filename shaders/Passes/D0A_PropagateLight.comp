layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(r11f_g11f_b10f) uniform image3D lightPropagationVolume;

const ivec3 workGroups = ivec3(64, 64, 64);

#include "../InternalLib/Syntax.glsl"
#include "../InternalLib/Utilities.glsl"
#include "../InternalLib/Debug.glsl"

uniform sampler3D voxelLightTex_r;
uniform sampler3D lightPropagationVolumeFeedback_r;

uniform vec3 previousCameraPosition, cameraPosition;

vec3 PropagateLight(float attenuation, ivec3 iPos, ivec3 voxelPos, sampler3D tex) {
    vec3 sum = vec3(0.0);

    // Voxel is filled: don't propagate light.
    if (attenuation > 0.8) return vec3(0.0);

    ivec3 offsets[6] = ivec3[6](
        ivec3(0, 1, 0),
        ivec3(0, -1, 0), 
        ivec3(1, 0, 0),
        ivec3(-1, 0, 0), 
        ivec3(0, 0, 1),
        ivec3(0, 0, -1)
    );

    for (int i = 0; i < 6; i++) {
        sum += texelFetch(tex, iPos + offsets[i], 0).rgb;
    }

    return sum / 6.0;
}

void main() {
    #ifndef COLORED_LIGHTING
        return;
    #endif

    ivec3 iPos = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 voxelPos = iPos;
    
    vec4 lights = texelFetch(voxelLightTex_r, voxelPos, 0);
    
    vec3 propagatedResult = PropagateLight(
        lights.a,
        iPos + ivec3(floor(cameraPosition) - floor(previousCameraPosition)),
        voxelPos,
        lightPropagationVolumeFeedback_r
    );
 
    vec3 result = lights.rgb + propagatedResult;
    imageStore(lightPropagationVolume, iPos, vec4(result, 1.0));
}
