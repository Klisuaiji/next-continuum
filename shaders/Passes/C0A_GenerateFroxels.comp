#include "../InternalLib/Fragment/Sky.fsh"
#include "../InternalLib/Common/Voxelization.glsl"
#include "../InternalLib/Fragment/Clouds.fsh"
#include "../InternalLib/Common/Froxels.glsl"
#include "../InternalLib/Common/FroxelVolume.glsl"

void ReprojectFroxels(inout vec3 scattering, inout vec3 transmittance, vec3 nCoord, ivec3 iPos) {
    vec3 reprojectedCoord = FroxelSpaceToWorldSpace(nCoord);
         reprojectedCoord += (cameraPosition - previousCameraPosition);
         reprojectedCoord = WorldSpaceToFroxelSpace(reprojectedCoord, CameraTransformsPrevious.viewMatrix, CameraTransformsPrevious.projectionMatrix);

    vec3 previousScattering = texture(integratedScattering, reprojectedCoord).rgb;
    vec3 previousTransmittance = texture(integratedTransmittance, reprojectedCoord).rgb;

    float blendWeight = 0.9 * float(clamp01(reprojectedCoord) == reprojectedCoord);

    if (!SceneData.sceneChange) {
        scattering = mix(scattering, previousScattering, blendWeight);
        transmittance = mix(transmittance, previousTransmittance, blendWeight);
    }

}

// TODO: Move shadowing out of here and calculate it at either full or half res instead. 
// This would also require integrating at full/half res. Needs investigation. 
// Phase function can also be applied at full res. 

void main() {
    InitRand(uint(gl_GlobalInvocationID.x + viewWidth * gl_GlobalInvocationID.y) + (uint(viewWidth) * uint(viewHeight) * floatBitsToUint(frameTimeCounter)));

    ivec3 iPos = ivec3(gl_GlobalInvocationID);
    vec3 nCoord = vec3(iPos + 0.5) / vec3(workGroups * gl_WorkGroupSize);

    #ifndef VOLUMETRIC_LIGHT 
        imageStore(froxelScatteringImg, iPos, vec4(0.0));
        imageStore(froxelTransmittanceImg, iPos, vec4(1.0));
        return;
    #endif

    vec3 worldPos = FroxelSpaceToWorldSpace(nCoord);

    vec3 scattering = vec3(0.0);
    vec3 transmittance = vec3(1.0);

    GenerateFroxels(scattering, transmittance, worldPos, iPos);
    ReprojectFroxels(scattering, transmittance, nCoord, iPos);

    imageStore(froxelScatteringImg, iPos, vec4(scattering, 0.0));
    imageStore(froxelTransmittanceImg, iPos, vec4(transmittance, 0.0));
}