layout (r11f_g11f_b10f) uniform image3D froxelScatteringImg;
layout (r11f_g11f_b10f) uniform image3D froxelTransmittanceImg;

const ivec3 workGroups = ivec3(64, 32, 8);

#include "../InternalLib/Syntax.glsl"

